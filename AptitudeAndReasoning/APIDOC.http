###
GET http://127.0.0.1:8000/aptitude/
Accept: application/json

###
POST http://127.0.0.1:8000/aptitude/
Content-Type: application/json

{
    "title": "What is 25% of 200?",
    "option_a": "25",
    "option_b": "50",
    "option_c": "75",
    "option_d": "100",
    "correct_option": "B",
    "category": "quantitative",
    "difficulty": "easy",
    "explanation": "25% of 200 is (25 / 100) * 200 = 50.",
    "marks": 1,
    "is_active": true
}

###
GET http://127.0.0.1:8000/aptitude/2/
Accept: application/json


###
PUT http://127.0.0.1:8000/aptitude/2/
Content-Type: application/json

{
    "title": "If a train travels 240 km in 4 hours, what is its average speed?",
    "option_a": "40 km/h",
    "option_b": "50 km/h",
    "option_c": "60 km/h",
    "option_d": "80 km/h",
    "correct_option": "C",
    "category": "quantitative",
    "difficulty": "easy",
    "explanation": "Average speed = Distance / Time = 240 / 4 = 60 km/h.",
    "marks": 1,
    "is_active": true
}

###
DELETE  http://127.0.0.1:8000/aptitude/3/


